<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-06-23T15:31:23.124Z" agent="Codex" version="24.7.17" type="device"><diagram id="im-ur-biny-erd" name="ERD"><mxGraphModel dx="1840" dy="1360" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
    <mxCell id="title" value="&lt;b&gt;ERD - I'm ur Biny&lt;/b&gt;&lt;br&gt;Domain data untuk Flutter app pemilah sampah ML/AI" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=24;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="70" y="35" width="560" height="70" as="geometry"/></mxCell>
    <mxCell id="pipeline" value="Pipeline: LocalDataset lookup -&gt; RT-DETR on-device -&gt; TFLite fallback -&gt; Gemini cloud retry/escalation. Output akhirnya selalu menjadi ScanResult." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#FDBA74;fillColor=#FFF7ED;fontFamily=Arial;fontSize=13;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="695" y="75" width="1125" height="48" as="geometry"/></mxCell>
    <mxCell id="user_session" value="&lt;b&gt;USER_SESSION&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Persistence: SharedPreferences&lt;/font&gt;&lt;br&gt;PK session_id (logical)&lt;br&gt;userName : String&lt;br&gt;totalXP : int&lt;br&gt;scanCount : int&lt;br&gt;correctionCount : int&lt;br&gt;scanHistory : List&lt;ScanResult&gt; (runtime)&lt;br&gt;keys: user_name, total_xp, scan_count, correction_count" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#2563eb;" vertex="1" parent="1"><mxGeometry x="70" y="145" width="420" height="330" as="geometry"/></mxCell>
    <mxCell id="scan_context" value="&lt;b&gt;SCAN_CONTEXT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Runtime State: Riverpod&lt;/font&gt;&lt;br&gt;PK context_id (logical)&lt;br&gt;scanMode : single | mixed&lt;br&gt;selectedCategory? : WasteCategory&lt;br&gt;capturedImage? : Uint8List&lt;br&gt;useGemini : bool&lt;br&gt;lastUsedGemini : bool&lt;br&gt;selectedDetailIndex : int&lt;br&gt;reanalyzeMultiIndex? : int" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#7c3aed;" vertex="1" parent="1"><mxGeometry x="70" y="540" width="420" height="330" as="geometry"/></mxCell>
    <mxCell id="local_dataset_entry" value="&lt;b&gt;LOCAL_DATASET_ENTRY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Persistence: Hive box local_dataset&lt;/font&gt;&lt;br&gt;PK sha256Hex : String&lt;br&gt;pHash : int&lt;br&gt;FK category_code : WasteCategory&lt;br&gt;itemName? : String&lt;br&gt;confidence? : double&lt;br&gt;imageFileName : String&lt;br&gt;createdAt : DateTime&lt;br&gt;dedupe key = sha256Hex; similarity = pHash/Hamming" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#059669;" vertex="1" parent="1"><mxGeometry x="70" y="945" width="510" height="350" as="geometry"/></mxCell>
    <mxCell id="scan_result" value="&lt;b&gt;SCAN_RESULT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Domain Model: lib/core/models/scan_result.dart&lt;/font&gt;&lt;br&gt;PK scan_result_id (logical)&lt;br&gt;itemName : String&lt;br&gt;FK category_code : WasteCategory&lt;br&gt;confidence : double&lt;br&gt;disposalInfo : String&lt;br&gt;description : String&lt;br&gt;isCorrected : bool&lt;br&gt;FK original_category_code? : WasteCategory&lt;br&gt;funFact? : String&lt;br&gt;boundingBox? : Rect&lt;br&gt;croppedImage? : Uint8List&lt;br&gt;allProbabilities : Map&lt;String,double&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="695" y="155" width="500" height="500" as="geometry"/></mxCell>
    <mxCell id="detected_region" value="&lt;b&gt;DETECTED_REGION&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Transient Detection Data&lt;/font&gt;&lt;br&gt;PK region_id (logical)&lt;br&gt;FK scan_result_id (logical)&lt;br&gt;displayRect : Rect&lt;br&gt;classificationRect : Rect&lt;br&gt;imageWidth : int&lt;br&gt;imageHeight : int&lt;br&gt;source: RT-DETR | Validator | Gemini bbox" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#9333ea;" vertex="1" parent="1"><mxGeometry x="695" y="740" width="500" height="300" as="geometry"/></mxCell>
    <mxCell id="dataset_image_file" value="&lt;b&gt;DATASET_IMAGE_FILE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;File Storage&lt;/font&gt;&lt;br&gt;PK imageFileName : String&lt;br&gt;path : &lt;app_docs&gt;/dataset/&lt;imageFileName&gt;&lt;br&gt;bytes : JPEG&lt;br&gt;written by dataset_image_storage_io.dart" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#0f766e;" vertex="1" parent="1"><mxGeometry x="695" y="1110" width="500" height="220" as="geometry"/></mxCell>
    <mxCell id="waste_category" value="&lt;b&gt;WASTE_CATEGORY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Enum / Master Data&lt;/font&gt;&lt;br&gt;PK category_code : enum value&lt;br&gt;displayName : String&lt;br&gt;subtitle : String&lt;br&gt;icon : IconData&lt;br&gt;color / softColor : Color&lt;br&gt;disposalInfo : String&lt;br&gt;eduFact : String&lt;br&gt;values: Kaca, Kertas, Logam, Organik, Plastik, Residu, Lainnya" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#0891b2;" vertex="1" parent="1"><mxGeometry x="1340" y="145" width="480" height="390" as="geometry"/></mxCell>
    <mxCell id="disposal_step" value="&lt;b&gt;DISPOSAL_STEP&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Derived From WasteCategory&lt;/font&gt;&lt;br&gt;PK (category_code, step_order)&lt;br&gt;FK category_code : WasteCategory&lt;br&gt;step_order : int&lt;br&gt;title : String&lt;br&gt;detail : String&lt;br&gt;source: WasteCategoryX.disposalSteps" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#0891b2;" vertex="1" parent="1"><mxGeometry x="1340" y="610" width="480" height="290" as="geometry"/></mxCell>
    <mxCell id="category_probability" value="&lt;b&gt;CATEGORY_PROBABILITY&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;Prediction Breakdown&lt;/font&gt;&lt;br&gt;PK (scan_result_id, category_name)&lt;br&gt;FK scan_result_id (logical)&lt;br&gt;category_name : String&lt;br&gt;probability : double&lt;br&gt;source: ScanResult.allProbabilities&lt;br&gt;used by confidence/top-probability UI" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#98A2B3;fillColor=#FFFFFF;fontFamily=Arial;fontSize=13;align=left;spacingLeft=10;spacingRight=10;spacingTop=8;verticalAlign=top;shadow=1;swimlaneFillColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="1340" y="990" width="480" height="290" as="geometry"/></mxCell>
    <mxCell id="edge_session_result" value="scanHistory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;endArrow=ERzeroToMany;strokeColor=#475467;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="user_session" target="scan_result"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_context_result" value="currentResult / multiResults" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;endArrow=ERzeroToMany;strokeColor=#475467;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="scan_context" target="scan_result"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_result_category" value="category" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERone;strokeColor=#475467;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="scan_result" target="waste_category"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_result_original_category" value="originalCategory?" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;strokeColor=#475467;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="scan_result" target="waste_category"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_category_step" value="disposalSteps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;endArrow=ERzeroToMany;strokeColor=#475467;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="waste_category" target="disposal_step"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_result_probability" value="allProbabilities" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;endArrow=ERzeroToMany;strokeColor=#475467;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="scan_result" target="category_probability"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_result_region" value="boundingBox / crop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;endArrow=ERzeroToOne;strokeColor=#7E22CE;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="scan_result" target="detected_region"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_dataset_category" value="final category" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERone;strokeColor=#047857;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="local_dataset_entry" target="waste_category"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_dataset_file" value="imageFileName" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERone;endArrow=ERone;strokeColor=#047857;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="local_dataset_entry" target="dataset_image_file"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="edge_result_dataset" value="save confirmed / reuse match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERzeroToOne;strokeColor=#047857;fontFamily=Arial;fontSize=12;" edge="1" parent="1" source="scan_result" target="local_dataset_entry"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="notes" value="&lt;b&gt;Catatan:&lt;/b&gt;&lt;br&gt;ERD ini bersifat logis/domain. App saat ini memakai Riverpod state, SharedPreferences, Hive box, dan file JPEG lokal, bukan satu skema SQL fisik.&lt;br&gt;Urutan output ML: Kaca(0), Kertas(1), Logam(2), Organik(3), Plastik(4), Residu(5). Lainnya hanya kategori UI/unknown." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D0D5DD;fillColor=#F8FAFC;fontFamily=Arial;fontSize=13;align=left;spacing=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="1405" width="1750" height="64" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>